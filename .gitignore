# ── Backend (Python) ─────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
*.db
*.db-journal
backend/priorauth.db
backend/uploads/*
!backend/uploads/.gitkeep
backend/.env

# Trained model artifacts are generated by `python ml/train.py` and
# `python ml/build_reference.py` — reproducible from the CSV, so they don't
# need to live in git. Comment these out if you'd rather commit them so a
# fresh clone works without a training step.
# backend/ml/models/*.joblib
# backend/ml/models/metrics.json
# backend/ml/models/reference_profile.json

# ── Frontend (Node / Vite) ───────────────────────────────────────────────
frontend/node_modules/
frontend/dist/
frontend/.vite/
frontend/*.local
frontend/.env
frontend/.env.local

# ── Editors / OS ─────────────────────────────────────────────────────────
.vscode/
.idea/
.DS_Store
Thumbs.db
*.swp

# ── Logs ─────────────────────────────────────────────────────────────────
*.log
npm-debug.log*