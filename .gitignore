# ── Backend (Python) ─────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
*.db
*.db-journal
backend/priorauth.db
backend/uploads/*
!backend/uploads/.gitkeep
backend/.env

# Model 2's artifact IS committed on purpose: a fresh clone should run without
# a 90k-row training step. Regenerate it with
#   python ml/train_appeal.py --csv data/appeals_prediction_transformed.csv
# (ml/train.py is retired and will refuse to run.)
#
# The 36 MB training CSV is committed too, so the model is reproducible. If you
# would rather keep the repo small, uncomment the next line and host the CSV
# separately — nothing at runtime reads it, only the trainer does.
# backend/data/appeals_prediction_transformed.csv

# ── Frontend (Node / Vite) ───────────────────────────────────────────────
frontend/node_modules/
frontend/dist/
frontend/.vite/
frontend/*.local
frontend/.env
frontend/.env.local

